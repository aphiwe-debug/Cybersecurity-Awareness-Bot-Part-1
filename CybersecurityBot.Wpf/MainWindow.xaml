<Window x:Class="CybersecurityBot.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" Height="700" Width="900"
        Background="#0D1117" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo header -->
        <Border Grid.Row="0" BorderBrush="#238636" BorderThickness="0,0,0,2" Padding="0,0,0,8" Margin="0,0,0,12">
            <TextBlock x:Name="LogoText" FontFamily="Consolas" FontSize="9"
                       Foreground="#3FB950" HorizontalAlignment="Center"/>
        </Border>

        <!-- Chat area -->
        <Border Grid.Row="1" Background="#161B22" CornerRadius="8" Padding="8">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChatPanel"/>
            </ScrollViewer>
        </Border>

        <!-- Input row -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" FontSize="15" Padding="10"
                     Background="#0D1117" Foreground="White" CaretBrush="White"
                     BorderBrush="#30363D" KeyDown="InputBox_KeyDown"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="Send" Margin="8,0,0,0"
                    Padding="24,10" Background="#238636" Foreground="White"
                    FontWeight="Bold" BorderThickness="0" Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>