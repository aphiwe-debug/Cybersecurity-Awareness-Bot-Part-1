<UserControl x:Class="CybersecurityBot.Wpf.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Add task form -->
        <Border Grid.Column="0" Background="#161B22" CornerRadius="8" Padding="14" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Add a cybersecurity task" Foreground="White" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TitleBox" MaxLength="150"/>
                <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DescriptionBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                         MaxLength="500" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Reminder" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="ReminderBox" SelectedIndex="0" SelectionChanged="ReminderBox_SelectionChanged">
                    <ComboBoxItem Content="No reminder"/>
                    <ComboBoxItem Content="In 1 day"/>
                    <ComboBoxItem Content="In 3 days"/>
                    <ComboBoxItem Content="In 7 days"/>
                    <ComboBoxItem Content="Pick a date..."/>
                </ComboBox>
                <DatePicker x:Name="CustomDate" Margin="0,6,0,0" Visibility="Collapsed"/>
                <Button Content="Add task" Style="{StaticResource ActionButton}" Margin="0,14,0,0"
                        HorizontalAlignment="Left" Click="AddButton_Click"/>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Task list -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Your tasks" Foreground="White" FontSize="16" FontWeight="Bold"/>
            <Border Grid.Row="1" Background="#161B22" CornerRadius="8" Padding="6" Margin="0,8">
                <ListBox x:Name="TaskList" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,4">
                                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold"
                                           FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Description}" Foreground="#C9D1D9" TextWrapping="Wrap"/>
                                <TextBlock Foreground="#8B949E" FontSize="12">
                                    <Run Text="{Binding StatusText, Mode=OneWay}"/><Run Text="    "/><Run Text="{Binding ReminderText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button Content="✔ Mark completed" Style="{StaticResource ActionButton}" Click="CompleteButton_Click"/>
                <Button Content="🗑 Delete" Style="{StaticResource ActionButton}" Background="#DA3633" Click="DeleteButton_Click"/>
                <Button Content="↻ Refresh" Style="{StaticResource ActionButton}" Background="#30363D" Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>