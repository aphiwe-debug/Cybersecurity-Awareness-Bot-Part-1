<<UserControl x:Class="CybersecurityBot.Wpf.QuizView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="OptionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Start screen -->
        <Border x:Name="StartPanel" Background="#161B22" CornerRadius="8" Padding="30">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock Text="🧠 Cybersecurity Quiz" Foreground="White" FontSize="26"
                           FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="12 multiple-choice and true/false questions on phishing, passwords, safe browsing and social engineering. You get feedback after every answer and a score at the end."
                           Foreground="#C9D1D9" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,20"/>
                <Button Content="Start quiz" Style="{StaticResource ActionButton}" HorizontalAlignment="Center"
                        Padding="34,12" Margin="0" Click="StartButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Question screen -->
        <Border x:Name="QuestionPanel" Visibility="Collapsed" Background="#161B22" CornerRadius="8" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="720" HorizontalAlignment="Center">
                    <TextBlock x:Name="ProgressText" Foreground="#8B949E" FontSize="13"/>
                    <TextBlock x:Name="QuestionText" Foreground="White" FontSize="19" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,8,0,14"/>
                    <Button x:Name="Option0" Tag="0" Style="{StaticResource OptionButton}" Click="Option_Click"/>
                    <Button x:Name="Option1" Tag="1" Style="{StaticResource OptionButton}" Click="Option_Click"/>
                    <Button x:Name="Option2" Tag="2" Style="{StaticResource OptionButton}" Click="Option_Click"/>
                    <Button x:Name="Option3" Tag="3" Style="{StaticResource OptionButton}" Click="Option_Click"/>
                    <Border x:Name="FeedbackBox" Visibility="Collapsed" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                        <TextBlock x:Name="FeedbackText" Foreground="White" TextWrapping="Wrap" FontSize="14"/>
                    </Border>
                    <Button x:Name="NextButton" Visibility="Collapsed" Style="{StaticResource ActionButton}"
                            HorizontalAlignment="Left" Margin="0,14,0,0" Click="NextButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Result screen -->
        <Border x:Name="ResultPanel" Visibility="Collapsed" Background="#161B22" CornerRadius="8" Padding="30">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock Text="Quiz complete!" Foreground="White" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ScoreText" Foreground="#3FB950" FontSize="52" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,10"/>
                <TextBlock x:Name="ResultMessage" Foreground="#C9D1D9" FontSize="18" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,0,0,20"/>
                <Button Content="Play again" Style="{StaticResource ActionButton}" HorizontalAlignment="Center"
                        Padding="34,12" Margin="0" Click="StartButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
    </UserControl>