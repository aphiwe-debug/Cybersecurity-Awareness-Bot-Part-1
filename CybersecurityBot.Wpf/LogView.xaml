<UserControl x:Class="CybersecurityBot.Wpf.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Activity log" Foreground="White" FontSize="16" FontWeight="Bold"/>
        <Border Grid.Row="1" Background="#161B22" CornerRadius="8" Padding="10" Margin="0,8">
            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                     Foreground="#C9D1D9" FontFamily="Consolas" FontSize="13"/>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button x:Name="MoreButton" Content="Show more" Style="{StaticResource ActionButton}" Click="MoreButton_Click"/>
            <Button x:Name="LessButton" Content="Show less" Style="{StaticResource ActionButton}" Background="#30363D" Click="LessButton_Click"/>
            <TextBlock x:Name="CountText" Foreground="#8B949E" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>